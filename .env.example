# Free OpenWeather API key. Used for geocoding and current conditions.
OPENWEATHER_API_KEY=replace_me

# Leave false for the zero-cost setup. Enable only after deliberately activating
# OpenWeather's separately billed One Call plan.
OPENWEATHER_ONE_CALL_ENABLED=false

# Supplies the eight-day forecast without a paid OpenWeather subscription and
# also protects current-weather requests during provider incidents.
OPEN_METEO_FALLBACK=true

# Server
PORT=8080
NODE_ENV=development
DEFAULT_TIME_ZONE=UTC
WEATHER_UNITS=metric
WEATHER_LANGUAGE=en

# Optional shared secret. Configure the same x-webhook-secret header in
# Dialogflow ES Fulfillment settings before enabling this in production.
WEBHOOK_SECRET=

# Keep the upstream budget below Dialogflow ES's five-second webhook limit.
UPSTREAM_TIMEOUT_MS=3500
GEOCODE_CACHE_TTL_MS=86400000
WEATHER_CACHE_TTL_MS=300000
